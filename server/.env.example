# EcoGrid AI - Backend Environment Configuration
# Smart India Hackathon 2026 - PS ID 26200

# Google Gemini API Key (keep secret, never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Frontend Origin for CORS security (default Vite dev server: http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173

# Server Port
PORT=8000
